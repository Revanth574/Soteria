[Unit]
Description=Soteria FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=soteria
Group=soteria
WorkingDirectory=/opt/soteria/backend
EnvironmentFile=/opt/soteria/backend/.env
ExecStart=/opt/soteria/backend/.venv/bin/uvicorn soteria.http.app:create_app_from_env --factory --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
