ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Optional. Leave unset for Claude models that reject temperature.
# ANTHROPIC_TEMPERATURE=0
SOTERIA_COMBINED_PROMPT_PATH=prompts/extract_policy_v1.2.md
# Leave RESEND_API_KEY unset to use the dev logging email sender.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@soteria.co.in
SOTERIA_PUBLIC_BASE_URL=https://soteria.co.in
DATABASE_URL=sqlite:///C:/soteria-data/ephemeral/soteria_dev.db
EPHEMERAL_DATA_DIR=C:/soteria-data/ephemeral
EPHEMERAL_TTL_SECONDS=86400
MAX_UPLOAD_BYTES=26214400
ANONYMOUS_UPLOADS_PER_IP_PER_HOUR=5
TRUST_PROXY_HEADERS=false
